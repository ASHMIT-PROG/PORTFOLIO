# Optional canonical URL. Vercel's production hostname is used when omitted.
NEXT_PUBLIC_SITE_URL=

# Server-only read-only GitHub token for the contributions GraphQL query.
# Never prefix a secret with NEXT_PUBLIC_. Missing token shows a neutral fallback.
GITHUB_TOKEN=

# Optional server-side email. Both values are needed; otherwise use mailto.
RESEND_API_KEY=
# A sender address on your verified Resend domain, for example:
# RESEND_FROM_EMAIL=Portfolio <hello@your-domain.example>
RESEND_FROM_EMAIL=

# Enable only after configuring Redis. Disabled by default.
ENABLE_VIEW_COUNTER=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Legacy Vercel KV variable names are also supported instead of Upstash names.
KV_REST_API_URL=
KV_REST_API_TOKEN=
